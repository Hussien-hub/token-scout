# Copy to .env (never committed). Real environment variables override these.

# Solana RPC for the on-chain dev & insider checks. Empty = the public endpoint,
# which allows about one transaction lookup per second. A Helius free key is ~10x faster:
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=
